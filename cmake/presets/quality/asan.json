        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-clang64-asan",
      "inherits": [
        "asan",
        "windows-clang64-debug"
      ],
      "displayName": "Windows / MSYS2 CLANG64 / AddressSanitizer",
      "description": "Configure an MSYS2 CLANG64 RelWithDebInfo platform build instrumented with AddressSanitizer.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-gcc-asan",
      "inherits": [
        "asan",
        "linux-gcc-debug"
      ],
      "displayName": "Linux / GCC / AddressSanitizer",
      "description": "Configure a Linux GCC RelWithDebInfo platform build instrumented with AddressSanitizer.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
