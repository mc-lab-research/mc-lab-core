{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "include": [
    "../platforms.json"
  ],
  "configurePresets": [
    {
      "name": "asan",
      "hidden": true,
      "cacheVariables": {
        "MC_LAB_CORE_SANITIZER": "ADDRESS"
      }
    },
    {
      "name": "windows-msvc-asan",
      "inherits": [
        "asan",
        "windows-msvc-debug"
      ],
      "displayName": "Windows / MSVC / AddressSanitizer",
      "description": "Configure a Windows MSVC RelWithDebInfo platform build instrumented with AddressSanitizer.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-visualstudio-2022-asan",
      "inherits": [
        "asan",
        "windows-visualstudio-2022"
      ],
      "displayName": "Windows / Visual Studio 2022 / AddressSanitizer",
      "description": "Configure a native Visual Studio RelWithDebInfo platform build instrumented with AddressSanitizer.",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-visualstudio-2026-asan",
      "inherits": [
        "asan",
        "windows-visualstudio-2026"
      ],
      "displayName": "Windows / Visual Studio 2026 / AddressSanitizer",
      "description": "Configure a native Visual Studio RelWithDebInfo platform build instrumented with AddressSanitizer.",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-clangcl-asan",
      "inherits": [
        "asan",
        "windows-clangcl-debug"
      ],
      "displayName": "Windows / clang-cl / AddressSanitizer",
