{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "MC_LAB_CORE_CONFIGURE_PRESET": "${presetName}",
        "MC_LAB_CORE_COMPILER_WARNINGS_AS_ERRORS": false,
        "MC_LAB_CORE_SANITIZER": "OFF",
        "MC_LAB_CORE_ENABLE_COVERAGE": false
      }
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    }
  ]
}
