# ==============================================================================
# Daedalux — Git File Attributes
# ==============================================================================
#
# Git stores text files with LF line endings in the repository.
#
# Developers may use Windows, Linux, or macOS, but commits and CI checkouts must
# remain deterministic and free from platform-specific line-ending churn.
# ==============================================================================

# Detect text files automatically and normalize their repository representation
# to LF.
* text=auto eol=lf


# ------------------------------------------------------------------------------
# Source code
# ------------------------------------------------------------------------------

*.c       text eol=lf
*.cc      text eol=lf
*.cpp     text eol=lf
*.cxx     text eol=lf
*.h       text eol=lf
*.hh      text eol=lf
*.hpp     text eol=lf
*.hxx     text eol=lf
*.inc     text eol=lf
*.inl     text eol=lf
*.ipp     text eol=lf
*.tpp     text eol=lf
*.ixx     text eol=lf
*.cppm    text eol=lf


# ------------------------------------------------------------------------------
# Language and build sources
# ------------------------------------------------------------------------------

*.l       text eol=lf
*.ll      text eol=lf
*.lex     text eol=lf
*.y       text eol=lf
*.yy      text eol=lf
*.yacc    text eol=lf
*.pml     text eol=lf

CMakeLists.txt text eol=lf
*.cmake        text eol=lf


# ------------------------------------------------------------------------------
# Configuration and documentation
# ------------------------------------------------------------------------------

*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.ini     text eol=lf
*.cfg     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf

.gitignore          text eol=lf
.gitattributes      text eol=lf
.clang-format       text eol=lf
.clang-tidy         text eol=lf
.clang-tidy-audit   text eol=lf


# ------------------------------------------------------------------------------
# Scripts
# ------------------------------------------------------------------------------

*.sh      text eol=lf
*.bash    text eol=lf
*.zsh     text eol=lf
*.py      text eol=lf
*.ps1     text eol=lf

# Native Windows command scripts conventionally use CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf


# ------------------------------------------------------------------------------
# Binary files
# ------------------------------------------------------------------------------

# Binary files must never undergo text conversion or line-ending normalization.
*.bmp     binary
*.gif     binary
*.ico     binary
*.jpg     binary
*.jpeg    binary
*.png     binary
*.webp    binary

*.pdf     binary

*.7z      binary
*.gz      binary
*.rar     binary
*.tar     binary
*.tgz     binary
*.zip     binary